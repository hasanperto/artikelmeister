PORT=3000

# ZORUNLU (production): en az 32 karakter rastgele anahtar. Üretmek için:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Production'da (NODE_ENV=production) eksik/zayıfsa sunucu başlamaz.
JWT_SECRET=

# ZORUNLU (production): en az 10 karakter, varsayılan olmayan şifre.
# DB'deki admin şifresi zayıfsa ve buraya güçlü bir şifre yazılırsa açılışta otomatik güncellenir.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# İsteğe bağlı: API'ye başka domainlerden erişim gerekiyorsa (virgülle ayırın)
# CORS_ORIGINS=https://ornek.com
# İsteğe bağlı: proxy güven ayarı (varsayılan: loopback — aynı sunucudaki Nginx)
# TRUST_PROXY=loopback

# ── Yapay zekâ (admin paneli + uygulamadaki AI Koç) ──
# En az bir anahtar tanımlayın. AI_PROVIDER varsayılan sağlayıcıdır (gemini | claude | minimax | openai);
# boşsa ilk tanımlı anahtar kullanılır. Uygulamada kullanıcı, tanımlı sağlayıcılar arasından seçebilir.
AI_PROVIDER=gemini

# Google Gemini (https://aistudio.google.com)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash

# Anthropic Claude (https://platform.claude.com)
ANTHROPIC_API_KEY=
AI_CLAUDE_MODEL=claude-opus-5-5
# Düşünme eforu: low (hızlı, ucuz — varsayılan) | medium | high
AI_CLAUDE_EFFORT=low

# AI Koç maliyet / güvenlik sınırları
# AI_PUBLIC_ENABLED=false        # uygulamadaki AI Koç'u kapatır (admin AI'ı etkilenmez)
# AI_PUBLIC_RATE_LIMIT=60        # IP başına 10 dakikada en fazla istek
# AI_PUBLIC_DAILY_LIMIT=2000     # günlük AI çağrısı (önbellekten gelenler sayılmaz)
# AI isteği zaman aşımı (ms)
# AI_TIMEOUT_MS=120000

# MiniMax (https://platform.minimax.io)
MINIMAX_API_KEY=
MINIMAX_MODEL=MiniMax-M3
MINIMAX_BASE_URL=https://api.minimax.io/v1

# OpenAI (alternatif)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1
